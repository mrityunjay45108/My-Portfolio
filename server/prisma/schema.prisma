generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ContentStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  posts        BlogPost[]

  @@map("users")
}

model Project {
  id                      String              @id @default(uuid())
  title                   String
  slug                    String              @unique
  shortDescription        String
  description             String
  category                String              @default("Full Stack")
  featured                Boolean             @default(false)
  published               Boolean             @default(true)
  githubUrl               String?
  githubOwner             String?
  githubRepository        String?
  liveUrl                 String?
  architectureImage       String?
  architectureDescription String?
  videoUrl                String?
  order                   Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  viewCount               Int                 @default(0)

  images                  ProjectImage[]
  features                ProjectFeature[]
  technologies            ProjectTechnology[]
  linkedGitHubRepo        GitHubRepository?

  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([published])
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("project_images")
}

model ProjectFeature {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int      @default(0)

  @@index([projectId])
  @@map("project_features")
}

model Technology {
  id           String                @id @default(uuid())
  name         String                @unique
  icon         String?
  category     String                @default("General") // Languages, Frontend, Backend, Databases, DevOps & Cloud, AI & GenAI
  createdAt    DateTime              @default(now())

  projects     ProjectTechnology[]
  caseStudies  CaseStudyTechnology[]

  @@index([category])
  @@map("technologies")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  posts       BlogPost[]

  @@map("blog_categories")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  posts     PostTag[]

  @@map("tags")
}

model BlogPost {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  excerpt       String
  content       String
  featuredImage String?
  authorId      String
  author        User          @relation(fields: [authorId], references: [id])
  status        ContentStatus @default(DRAFT)
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  readingTime   Int           @default(5)
  viewCount     Int           @default(0)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tags          PostTag[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@map("blog_posts")
}

model PostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model CaseStudy {
  id                      String                @id @default(uuid())
  title                   String
  slug                    String                @unique
  summary                 String
  problem                 String
  background              String?
  goals                   String?
  architecture            String?
  architectureImage       String?
  implementation          String?
  challenges              String?
  solutions               String?
  security                String?
  performance             String?
  results                 String?
  lessonsLearned          String?
  videoUrl                String?
  githubUrl               String?
  liveUrl                 String?
  featured                Boolean               @default(false)
  status                  ContentStatus         @default(DRAFT)
  order                   Int                   @default(0)
  viewCount               Int                   @default(0)
  publishedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  images                  CaseStudyImage[]
  technologies            CaseStudyTechnology[]
  sections                CaseStudySection[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@map("case_studies")
}

model CaseStudyImage {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([caseStudyId])
  @@map("case_study_images")
}

model CaseStudyTechnology {
  caseStudyId  String
  technologyId String
  caseStudy    CaseStudy  @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, technologyId])
  @@map("case_study_technologies")
}

model CaseStudySection {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  title       String
  content     String
  order       Int       @default(0)

  @@index([caseStudyId])
  @@map("case_study_sections")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  company   String?
  purpose   String?       @default("Job Opportunity")
  status    ContactStatus @default(NEW)
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model AnalyticsEvent {
  id           String    @id @default(uuid())
  eventType    String    // PAGE_VIEW, PROJECT_VIEW, PROJECT_GITHUB_CLICK, PROJECT_LIVE_DEMO_CLICK, BLOG_VIEW, CASE_STUDY_VIEW, RESUME_DOWNLOAD, CONTACT_FORM_OPEN, CONTACT_FORM_SUBMIT, GITHUB_PROFILE_CLICK, LINKEDIN_CLICK, AI_ASSISTANT_OPEN, AI_QUESTION, AI_SOURCE_CLICK, EXTERNAL_LINK_CLICK
  sessionId    String    // Anonymous browser session id
  page         String?   // e.g. "/", "/projects/ai-interview-copilot", "/blog"
  resourceType String?   // "project" | "blog" | "case_study" | "github" | "resume"
  resourceId   String?   // slug or id e.g. "ai-interview-copilot"
  referrer     String?   // Traffic referrer domain e.g. "github.com", "linkedin.com", "google.com", "direct"
  metadata     Json?     // Lightweight metadata (e.g. { source: "hero_button", category: "AI" })
  createdAt    DateTime  @default(now())

  @@index([eventType])
  @@index([sessionId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([referrer])
  @@map("analytics_events")
}

model VisitorAnalytics {
  id         String   @id @default(uuid())
  path       String
  type       String   @default("PAGE_VIEW")
  resourceId String?
  ipHash     String?
  userAgent  String?
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([type])
  @@index([createdAt])
  @@map("visitor_analytics")
}

model GitHubRepository {
  id                String    @id @default(uuid())
  owner             String
  name              String
  fullName          String    @unique
  description       String?
  url               String
  language          String?
  stars             Int       @default(0)
  forks             Int       @default(0)
  topics            String[]  @default([])
  featured          Boolean   @default(false)
  displayOrder      Int       @default(0)
  customDescription String?
  projectId         String?   @unique
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lastSyncedAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([owner])
  @@index([name])
  @@index([featured])
  @@index([displayOrder])
  @@map("github_repositories")
}

model AiConversation {
  id          String      @id @default(uuid())
  sessionId   String?
  title       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        Json?
  responseType   String?        @default("text")
  metadata       Json?
  latencyMs      Int?
  feedback       String?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiSetting {
  id               String   @id @default("default")
  enabled          Boolean  @default(true)
  provider         String   @default("gemini")
  model            String   @default("gemini-1.5-flash")
  systemPrompt     String?
  rateLimitPerMin  Int      @default(15)
  maxTokens        Int      @default(800)
  temperature      Float    @default(0.4)
  updatedAt        DateTime @updatedAt

  @@map("ai_settings")
}

model PortfolioSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portfolio_settings")
}
