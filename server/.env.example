PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
# For local development: direct or pooler URL
# For Render / cloud deployments: YOU MUST USE SUPABASE CONNECTION POOLER (IPv4)
# Direct connection (db.<ref>.supabase.co) only supports IPv6, which Render does not support!
# Format (Session mode, port 5432):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Or (Transaction mode, port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-here"
JWT_EXPIRES_IN="7d"

# Initial Seed
INITIAL_ADMIN_EMAIL="admin@mrityunjay.dev"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
INITIAL_ADMIN_NAME="Mrityunjay Kumar"

# Media Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"

# GitHub Integration
GITHUB_USERNAME="mrityunjay45108"
GITHUB_TOKEN=""
GITHUB_API_URL="https://api.github.com"

# AI Portfolio Assistant Configuration
AI_ENABLED="true"
AI_PROVIDER="gemini" # gemini | openai | anthropic | local
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
AI_RATE_LIMIT_PER_MINUTE="20"
AI_MAX_TOKENS="800"

